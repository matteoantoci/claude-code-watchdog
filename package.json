{
  "name": "claude-code-watchdog",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "validate": "claude plugin validate --strict plugins/watchdog",
    "test": "claude plugin test plugins/watchdog",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run validate && npm run test"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "oxc-config-ai-guardrails": "1.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  }
}
